{
  "name": "quizzy",
  "version": "1.4.0",
  "description": "Multiplayer music quiz game powered by Spotify",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "pnpm --filter server run dev",
    "dev:client": "pnpm --filter client run dev",
    "test": "pnpm --filter server run test",
    "test:watch": "pnpm --filter server run test:watch",
    "build": "pnpm --filter client run build",
    "start": "pnpm --filter server run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
