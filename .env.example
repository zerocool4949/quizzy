# Server configuration
NODE_ENV=production
PORT=3001

# Client URL for CORS (your domain)
CLIENT_URL=https://quizzy.yourdomain.com

# Public server URL (used for audio cache URLs in dev)
SERVER_URL=http://localhost:3001

# Admin page key (visit /admin?key=yourSecret)
ADMIN_KEY=changeme

# Comma-separated IPs allowed on /admin without a key
ADMIN_IPS=

# Reverse proxy hops in front of the server (needed for ADMIN_IPS behind a proxy)
TRUST_PROXY=

